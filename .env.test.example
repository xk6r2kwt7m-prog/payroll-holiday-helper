# Playwright E2E environment variables
# Copy this file to .env.test and fill in real values.
# NEVER commit .env.test with real credentials.

BASE_URL=http://localhost:5173

# Primary test account (used by default auth setup)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Optional per-role credentials for true boundary tests.
# When set, permissions.spec.ts runs multi-role boundary assertions.
# When absent, permissions tests run as single-account smoke only.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_SUPERVISOR_EMAIL=
E2E_SUPERVISOR_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
